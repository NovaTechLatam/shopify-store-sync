# Store Sync configuration. Copy this file to `.env` and fill in the values marked REQUIRED.
# Never commit `.env` or share it: it holds the keys to your stores.

# ---- Required -----------------------------------------------------------------------------------

# REQUIRED. The public HTTPS address of this service, without a trailing slash. Shopify sends
# stock notifications to `<PUBLIC_URL>/webhooks/shopify`, so it must be reachable from the internet.
# With `docker compose --profile https`, Caddy gets a free certificate for this domain.
PUBLIC_URL=https://sync.example.com

# REQUIRED. Encrypts the Shopify keys stored in the database. Generate it once with:
#   openssl rand -base64 32
# Keep a copy in your password manager: without it, a database backup can't be used and every
# store has to be connected again. Changing it later is not supported.
ENCRYPTION_KEY=

# REQUIRED. Login for the dashboard. The password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Database -----------------------------------------------------------------------------------

# REQUIRED with docker compose: password of the bundled Postgres database. Use letters and numbers
# only (it becomes part of a URL), for example `openssl rand -hex 24`. Set it before the first
# start; changing it afterwards does not change the database's password.
POSTGRES_PASSWORD=

# Postgres connection URL. Ignored by docker compose, which connects to its own database.
# REQUIRED everywhere else (local development, Render, Railway, a managed database...).
DATABASE_URL=postgres://storesync:change-me@localhost:5432/storesync
# Maximum database connections this process opens.
DATABASE_POOL_SIZE=10

# ---- Optional -----------------------------------------------------------------------------------

# Shopify Admin API version. Shopify supports each version for 12 months; 2026-10 works until
# October 2027. See docs/operations.md before changing it.
SHOPIFY_API_VERSION=2026-10

# Run the background sync in this process. Set to false only for extra web-only copies.
WORKER_ENABLED=true
# How many products are synced in parallel (1-64).
WORKER_CONCURRENCY=4
# How often every store is compared with the shared stock, to catch missed notifications (minutes).
RECONCILE_INTERVAL_MINUTES=15
# How often every store's product list (SKUs, variants, locations) is re-read (minutes, at least 5).
CATALOG_REFRESH_INTERVAL_MINUTES=360

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# development, production or test. The Docker image sets production.
NODE_ENV=production
# Address and port the web server listens on. Keep 3000 with docker compose (it maps that port).
HOST=0.0.0.0
PORT=3000
